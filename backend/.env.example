# Copy to .env and fill in.

# ----- Supabase (database only) -----
# Django connects to Postgres with this. Not your Supabase dashboard login.
# Get URI: Dashboard → Connect → Transaction (or Session). Encode password: @=%40, #=%23.
DATABASE_URL=postgresql://postgres.[REF]:[DB-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres

# ----- Django -----
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Tripster app admin (not Supabase) -----
# Admin user for logging into Tripster as Admin (create via Django admin or ensure user has role Admin).
# ADMIN_EMAIL=admin@tripster.com
# ADMIN_PASSWORD=YourAppAdminPassword
