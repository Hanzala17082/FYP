# Copy to .env and fill in.
# This backend uses Supabase Postgres only (no SQLite). Django reads DATABASE_URL or builds one from SUPABASE_* below.

# ----- Supabase Postgres -----

# Option A — Full URI from Dashboard -> Connect (copy exactly; transaction pooler example shape):
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres
# Session pooler often uses port 5432 and aws-0-* vs aws-1-* depends on project — always paste what Supabase shows.

# Option B — Password + ref (URI encoding handled in settings).
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_REGION=ap-northeast-2
SUPABASE_CONNECTION=direct
# SUPABASE_DB_PASSWORD=your-database-password

# Option C — Session pooler via settings (IPv4-friendly; user postgres.[REF], port 5432 — copy host from Dashboard → Connect → Session mode):
# SUPABASE_CONNECTION=pooler
# SUPABASE_POOLER_HOST=aws-1-ap-northeast-2.pooler.supabase.com
# SUPABASE_POOLER_PORT=5432

# ----- Django -----
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ----- Tripster app admin (not Supabase) -----
# ADMIN_EMAIL=admin@tripster.com
# ADMIN_PASSWORD=YourAppAdminPassword
