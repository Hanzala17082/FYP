# Supabase (browser + SSR — required for Auth + PostgREST)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer JWT anon for PostgREST (Dashboard → Settings → API → anon public):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt

# Optional newer publishable key (sb_publishable_…) if anon is not set:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Server-only — required for /api/auth/register (admin createUser). NOT required for forgot-password.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Legacy Django REST URL — used for live chat (Django Channels)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Frontend Site URL (for SEO, metadata, and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Password reset (required Supabase Dashboard setup) -----
# Authentication → URL Configuration:
#   Site URL: http://localhost:3000
#   Redirect URLs (add all):
#     http://localhost:3000/auth/confirm
#     http://localhost:3000/auth/confirm/**
#     http://localhost:3000/reset-password
#     http://localhost:3000/**
#
# Forgot password uses supabase.auth.resetPasswordForEmail with redirect:
#   /auth/confirm?next=/reset-password
#
# For reliable Gmail delivery, configure SMTP in:
#   Supabase Dashboard → Project Settings → Authentication → SMTP Settings
#
# Dev-only: /api/auth/forgot-password returns a clickable reset link on screen when
# SUPABASE_SERVICE_ROLE_KEY is set (in addition to Supabase sending the email).

# ----- Wallet (in-app PKR balance for trip bookings) -----
# Seed balance for new traveler wallets (random PKR 10M–25M unless WALLET_SEED_BALANCE is set).
# WALLET_SEED_BALANCE=50000
WALLET_SEED_MIN=10000000
WALLET_SEED_MAX=25000000
WALLET_CURRENCY=PKR
#
# Profile avatars: run supabase/avatars_storage.sql once in Supabase SQL Editor.
#
# ----- Transactional email (booking confirmations) -----
# Sign up at https://resend.com — free tier works for FYP demos.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be a verified sender domain in Resend (or use onboarding@resend.dev for testing):
RESEND_FROM_EMAIL=Tripster <onboarding@resend.dev>

# Node Environment
NODE_ENV=development
