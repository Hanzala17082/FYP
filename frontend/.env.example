# Supabase (browser + SSR — required for Auth + PostgREST)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Prefer JWT anon for PostgREST (Dashboard → Settings → API → anon public):
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_jwt

# Optional newer publishable key (sb_publishable_…) if anon is not set:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Legacy Django REST URL — unused when all services call Supabase directly
# NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Frontend Site URL (for SEO and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
